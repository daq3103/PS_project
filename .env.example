# Copy to .env — NEVER commit .env

POSTGRES_USER=petshop
POSTGRES_PASSWORD=petshop_dev_change_me
POSTGRES_DB=petshop

DATABASE_URL=postgresql+asyncpg://petshop:petshop_dev_change_me@postgres:5432/petshop

REDIS_CACHE_URL=redis://redis-cache:6379/0
REDIS_CACHE_PASSWORD=redis_cache_pass_change_me
REDIS_QUEUE_URL=redis://redis-queue:6379/0
REDIS_QUEUE_PASSWORD=redis_queue_pass_change_me

# JWT (HS256) — generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change_me_jwt_secret_min_32_chars_xxxxxxxxxxxx
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

# AES-256-GCM master key (64 hex chars = 32 bytes). Generate:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS

# Next.js ISR revalidation
REVALIDATE_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
NEXTJS_REVALIDATE_URL=http://nextjs:3000/api/revalidate

# App
APP_ENV=development

# Online payment: COD is always available; payOS appears only when all fields are configured.
# Register a channel at https://my.payos.vn — never put these keys in NEXT_PUBLIC_*.
PAYMENT_PROVIDER=payos
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
# APP_PUBLIC_URL already appears below: set it to the real HTTPS origin.
# Fixed customer shipping fee, independent of the carrier's actual invoice.
SHIPPING_BASE_FEE=25000
SHIPPING_PER_KG_FEE=5000
# Exclude lots expiring today; increase this margin to cover delivery + minimum remaining life.
INVENTORY_MIN_SHELF_LIFE_DAYS=0
APP_PUBLIC_URL=
CORS_ORIGINS=http://localhost:3000,http://localhost
TZ=Asia/Ho_Chi_Minh

# Mock VietQR webhook HMAC (Week 4 local)
MOCK_VIETQR_WEBHOOK_SECRET=mock_vietqr_webhook_secret_dev
MOCK_GHN_WEBHOOK_SECRET=mock_ghn_webhook_secret_dev

# Verified sender and public site URL are required for password reset emails.
RESEND_API_KEY=
RESEND_FROM=
# Password reset delivery: resend or gmail. Gmail uses SMTP over TLS (port 465).
PASSWORD_RESET_EMAIL_PROVIDER=resend
GMAIL_USER=
GOOGLE_CLIENT_ID=
# Google app password, not the normal Gmail password. Keep only in local .env.
GMAIL_APP_PASSWORD=
COMMUNITY_ENABLED=true
# Development can run without Turnstile. Non-development fails closed without its secret.
COMMUNITY_TURNSTILE_SITE_KEY=
COMMUNITY_TURNSTILE_SECRET=
COMMUNITY_TURNSTILE_HOSTNAME=
COMMUNITY_RETENTION_DAYS=90
# Actual Docker proxy subnet; default Compose is 172.16.0.0/12. Restrict to your subnet in production.
TRUSTED_PROXY_CIDRS=172.16.0.0/12
# First-party analytics (owner dashboard /admin/analytics)
ANALYTICS_ENABLED=true
ANALYTICS_RETENTION_DAYS=90

# Rescue contributions are independent from Shop. Leave disabled until recipient/policies are verified.
RESCUE_DONATIONS_ENABLED=false
RESCUE_FUND_POLICY_CONFIRMED=false
RESCUE_RECIPIENT_NAME=
RESCUE_BANK_NAME=
RESCUE_BANK_ACCOUNT=
RESCUE_MERCHANT_ID=
RESCUE_WEBHOOK_SECRET=

# Pause rescue automation while reconciling restored data.
RESCUE_AUTOMATION_PAUSED=false
# Optional bounded backup sidecar; set a verified NAS/off-machine path before including its Compose file.
BACKUP_HOST_DIR=
BACKUP_INTERVAL_SECONDS=86400
BACKUP_MAX_TOTAL_MB=5000
BACKUP_MAX_MEDIA_MB=500

# SEO: set the official HTTPS origin before enabling Google indexing.
SITE_URL=
SEO_ALLOW_INDEXING=false
